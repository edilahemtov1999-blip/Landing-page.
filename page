<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Вебинар Продуктивность на практике — регистрация</title>
  <meta name="description" content="Интенсив по техникам продуктивности: Pomodoro, приоритизация, шаблоны планирования." />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    :root{
      --blue:#0A66C2; --accent:#FF7A00; --bg:#f7f9fc; --card:#ffffff; --muted:#6b7280; --text:#0b1220;
      font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, Arial;
    }
    *{box-sizing:border-box}
    body{margin:0;background:var(--bg);color:var(--text);line-height:1.5}
    .container{max-width:1100px;margin:0 auto;padding:28px}
    .topbar{display:flex;justify-content:space-between;align-items:center;padding:12px 0}
    header.hero{display:flex;gap:28px;align-items:center;padding:40px 0}
    .hero-left{flex:1}
    h1{font-size:32px;margin:0 0 12px;font-weight:700}
    p.lead{margin:0 0 18px;color:#334155;font-size:16px}
    .cta{display:inline-block;background:var(--accent);color:#fff;padding:12px 20px;border-radius:10px;text-decoration:none;font-weight:700}
    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 6px 18px rgba(11,18,32,0.06)}
    .grid{display:grid;grid-template-columns:1fr 360px;gap:20px}
    .benefits{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin:16px 0}
    .benefit{background:#f8fafc;padding:14px;border-radius:10px;border:1px solid #eef2f6}
    section{margin:22px 0}
    .program li{margin:8px 0}
    form input, form button, form textarea{width:100%;padding:10px;margin:8px 0;border:1px solid #e6e9ef;border-radius:8px;font-size:14px}
    .gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
    .gallery img{width:100%;height:160px;object-fit:cover;border-radius:8px;cursor:pointer}
    .testimonials{display:flex;gap:12px;overflow:hidden}
    .testimonial{min-width:260px;background:#fff;padding:12px;border-radius:10px;border:1px solid #eef2f6}
    .stars{color:#f59e0b;font-weight:700}
    footer{padding:24px 0;color:var(--muted);font-size:14px}
    @media(max-width:980px){
      .grid{grid-template-columns:1fr}
      header.hero{flex-direction:column;align-items:flex-start}
      .gallery{grid-template-columns:repeat(2,1fr)}
      .testimonials{overflow-x:auto}
    }
    .lightbox{position:fixed;inset:0;background:rgba(0,0,0,0.75);display:flex;align-items:center;justify-content:center;padding:20px;visibility:hidden;opacity:0;transition:opacity .18s}
    .lightbox.open{visibility:visible;opacity:1}
    .lightbox img{max-width:95%;max-height:90%;border-radius:8px}
    .sr-only{position:absolute;left:-9999px}
  </style>
</head>
<body>
  <div class="container">
    <div class="topbar">
      <div><strong>Productivity.kz</strong></div>
      <nav>
        <a href="#program" style="margin-right:12px;color:var(--muted);text-decoration:none">Программа</a>
        <a href="#gallery" style="margin-right:12px;color:var(--muted);text-decoration:none">Галерея</a>
        <a href="#register" style="color:var(--blue);text-decoration:none">Регистрация</a>
      </nav>
    </div>

    <header class="hero" role="banner">
      <div class="hero-left">
        <h1>Научитесь делать больше за меньшее время</h1>
        <p class="lead">Практические техники тайм‑менеджмента, фокус‑сессии и шаблоны для ежедневного планирования. 3 часа, живой формат, раздаточные материалы.</p>
        <a class="cta" href="#register">Зарегистрироваться — бесплатно</a>
      </div>
      <div class="hero-right card" style="width:320px">
        <strong>Следующий поток</strong>
        <p style="margin:8px 0 0">20 января 2026 • 19:00 (ALMT)</p>
        <p style="margin:12px 0 0;font-weight:600;color:var(--accent)">Места ограничены — 50 бесплатных</p>
      </div>
    </header>

    <div class="grid" role="main">
      <main>
        <section class="card" id="about">
          <h2 style="margin-top:0">Описание</h2>
          <p>Короткий интенсив для тех, кто устал от теории и хочет конкретных инструментов: Pomodoro, приоритизация по важности, техника «двух минут» и шаблоны для планирования задач. Формат — практические упражнения в реальном времени и готовые шаблоны для дальнейшего использования.</p>
        </section>

        <section class="card" id="features">
          <h2 style="margin-top:0">Преимущества</h2>
          <div class="benefits">
            <div class="benefit"><strong>План на 30 дней</strong> готовый шаблон для ежедневной работы</div>
            <div class="benefit"><strong>Три техники</strong> для немедленного повышения концентрации</div>
            <div class="benefit"><strong>Практика</strong> в реальном времени с обратной связью</div>
            <div class="benefit"><strong>Запись</strong> и материалы после вебинара</div>
          </div>
        </section>

        <section class="card" id="gallery" aria-label="Галерея">
          <h2 style="margin-top:0">Галерея</h2>
          <p style="color:var(--muted);margin-top:0">Ниже — примеры слайдов и рабочих материалов</p>
          <div class="gallery" id="galleryGrid">
            <img src="https://via.placeholder.com/600x400?text=Слайд+1" alt="Слайд 1" data-full="https://via.placeholder.com/1200x800?text=Слайд+1">
            <img src="https://via.placeholder.com/600x400?text=Слайд+2" alt="Слайд 2" data-full="https://via.placeholder.com/1200x800?text=Слайд+2">
            <img src="https://via.placeholder.com/600x400?text=Слайд+3" alt="Слайд 3" data-full="https://via.placeholder.com/1200x800?text=Слайд+3">
            <img src="https://via.placeholder.com/600x400?text=Материал+1" alt="Материал 1" data-full="https://via.placeholder.com/1200x800?text=Материал+1">
            <img src="https://via.placeholder.com/600x400?text=Материал+2" alt="Материал 2" data-full="https://via.placeholder.com/1200x800?text=Материал+2">
            <img src="https://via.placeholder.com/600x400?text=Материал+3" alt="Материал 3" data-full="https://via.placeholder.com/1200x800?text=Материал+3">
          </div>
        </section>

        <section class="card" id="program">
          <h2 style="margin-top:0">Программа</h2>
          <ul class="program">
            <li>Введение и диагностика продуктивности — 20 мин</li>
            <li>Техника Pomodoro и адаптация — 40 мин</li>
            <li>Приоритизация задач и шаблоны — 40 мин</li>
            <li>Практическая сессия: план на неделю — 50 мин</li>
            <li>Вопросы и ответы — 30 мин</li>
          </ul>
        </section>

        <section class="card" id="testimonials">
          <h2 style="margin-top:0">Отзывы участников</h2>
          <div class="testimonials" id="testiWrap" aria-live="polite">
            <div class="testimonial">
              <div style="display:flex;gap:10px;align-items:center">
                <img src="https://via.placeholder.com/48" alt="Фото клиента" style="width:48px;height:48px;border-radius:50%;object-fit:cover">
                <div>
                  <strong>Айжан</strong>
                  <div class="stars">★★★★★</div>
                </div>
              </div>
              <p style="margin-top:8px;color:var(--muted)">Очень полезный интенсив — сразу внедрила Pomodoro и стала успевать больше.</p>
            </div>

            <div class="testimonial">
              <div style="display:flex;gap:10px;align-items:center">
                <img src="https://via.placeholder.com/48" alt="Фото клиента" style="width:48px;height:48px;border-radius:50%;object-fit:cover">
                <div>
                  <strong>Марат</strong>
                  <div class="stars">★★★★☆</div>
                </div>
              </div>
              <p style="margin-top:8px;color:var(--muted)">Практические шаблоны помогли организовать рабочий день.</p>
            </div>

            <div class="testimonial">
              <div style="display:flex;gap:10px;align-items:center">
                <img src="https://via.placeholder.com/48" alt="Фото клиента" style="width:48px;height:48px;border-radius:50%;object-fit:cover">
                <div>
                  <strong>Сауле</strong>
                  <div class="stars">★★★★★</div>
                </div>
              </div>
              <p style="margin-top:8px;color:var(--muted)">Отличный формат: теория + практика. Рекомендую.</p>
            </div>
          </div>
        </section>
      </main>

      <aside>
        <div id="register" class="card" aria-labelledby="regTitle">
          <h3 id="regTitle" style="margin-top:0">Регистрация</h3>
          <form id="regForm" novalidate>
            <label class="sr-only" for="name">Имя</label>
            <input type="text" name="name" id="name" placeholder="Ваше имя" required />
            <label class="sr-only" for="email">Email</label>
            <input type="email" name="email" id="email" placeholder="Email" required />
            <label class="sr-only" for="phone">Телефон</label>
            <input type="tel" name="phone" id="phone" placeholder="Телефон (необязательно)" />
            <button type="submit" style="background:var(--blue);color:#fff;border:none;padding:12px;border-radius:8px;font-weight:700">Зарегистрироваться</button>
            <p style="font-size:13px;color:var(--muted);margin-top:8px">Бесплатно для первых 50 участников</p>
          </form>
        </div>

        <div class="card" style="margin-top:16px">
          <strong>Цена</strong>
          <p style="margin:8px 0 0">Бесплатно для первых 50 участников; далее — 2 500 ₸</p>
          <a href="#register" class="cta" style="display:inline-block;margin-top:12px">Забронировать место</a>
        </div>
      </aside>
    </div>

    <footer>
      <div class="card" style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap">
        <div>
          <strong>Productivity.kz</strong>
          <div style="color:var(--muted);margin-top:6px">Контакты: info@productivity.kz • Тел: +7 (700) 000‑00‑00</div>
        </div>
        <div style="text-align:right">
          <div style="color:var(--muted)">Соцсети: Instagram / Telegram</div>
          <div style="margin-top:8px;color:var(--muted);font-size:13px">© 2026 Productivity.kz — Политика конфиденциальности</div>
        </div>
      </div>
    </footer>
  </div>

  <div id="lightbox" class="lightbox" role="dialog" aria-hidden="true">
    <img src="" alt="Просмотр изображения" id="lightboxImg">
  </div>

  <script>
    document.getElementById('regForm').addEventListener('submit', function(e){
      e.preventDefault();
      const name = document.getElementById('name').value.trim();
      const email = document.getElementById('email').value.trim();
      if(!name || !email){ alert('Пожалуйста, заполните имя и email'); return; }
      alert('Спасибо, вы зарегистрированы. Ссылка на вебинар придет на почту.');
      this.reset();
    });

    const gallery = document.getElementById('galleryGrid');
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightboxImg');
    gallery.addEventListener('click', (e) => {
      const img = e.target.closest('img');
      if(!img) return;
      const full = img.dataset.full || img.src;
      lightboxImg.src = full;
      lightbox.classList.add('open');
      lightbox.setAttribute('aria-hidden','false');
    });
    lightbox.addEventListener('click', () => {
      lightbox.classList.remove('open');
      lightbox.setAttribute('aria-hidden','true');
      lightboxImg.src = '';
    });
    document.addEventListener('keydown', (e) => {
      if(e.key === 'Escape') { lightbox.classList.remove('open'); lightbox.setAttribute('aria-hidden','true'); lightboxImg.src = ''; }
    });

    (function autoScrollTestimonials(){
      const wrap = document.getElementById('testiWrap');
      if(!wrap) return;
      let pos = 0;
      setInterval(() => {
        pos += 280;
        if(pos > wrap.scrollWidth - wrap.clientWidth) pos = 0;
        wrap.scrollTo({left: pos, behavior: 'smooth'});
      }, 4000);
    })();
  </script>
</body>
</html>
